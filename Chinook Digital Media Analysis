/*
--Query 6.: Provide a query that shows the invoices associated with each sales agent. The resulting table should include the Sales Agent's full name.
SELECT iv.InvoiceId, em.FirstName AS RepFirstName, em.LastName AS RepLastName
FROM invoices AS iv
LEFT JOIN customers AS cu
    ON iv.CustomerId = cu.CustomerId
LEFT JOIN employees AS em
    ON cu.SupportRepId = em.EmployeeId
    ORDER BY em.LastName
;
*/
/*
--Query 7.: Show the Invoice Total, Customer name, Country, and Sales Agent name for all invoices and customers.
SELECT iv.InvoiceId, SUM(it.UnitPrice * it.Quantity) AS invoice_total,
cu.FirstName AS CustomerFirstName, cu.LastName AS CustomerLastName,
cu.Country,
em.FirstName AS RepFirstName, em.LastName As RepLastName
FROM invoices AS iv
FULL JOIN customers AS cu
    ON iv.CustomerId = cu.CustomerId
LEFT JOIN employees AS em
    ON cu.SupportRepId = em.EmployeeId
LEFT JOIN invoice_items AS it
    ON iv.InvoiceId = it.InvoiceId
GROUP BY iv.InvoiceId
;
