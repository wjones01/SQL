/*
--Query 11.: Write a query that includes the purchased track name AND artist name with each invoice line ID.
SELECT it.InvoiceLineId, tr.Name AS Track_Name, ar.Name AS Artist_Name
FROM invoice_items AS it
LEFT JOIN tracks AS tr
    ON it.TrackId = tr.TrackId
LEFT JOIN artists AS ar
    ON tr.AlbumId = ar.ArtistId
ORDER BY InvoiceLineId ASC
;
