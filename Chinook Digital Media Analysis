/*
-- Query 12.: Provide a query that shows all the Tracks, and include the Album name, Media type, and Genre.
SELECT tr.Name AS TrackName, al.title AS AlbumTitle,me.Name AS MediaType,ge.Name AS Genre
FROM tracks AS tr
LEFT JOIN albums AS al
    ON tr.AlbumId = al.AlbumId
LEFT JOIN media_types AS me
    ON tr.MediaTypeId = me.MediaTypeId
LEFT JOIN genres AS ge
    ON tr.GenreId = ge.GenreId
ORDER BY al.Title
;
*/
/*
--Query 13.: Show the total sales made by each sales agent.
SELECT SUM (it.UnitPrice*it.Quantity) AS Sales, em.FirstName, em.LastName, em.Title
FROM invoice_items AS it
LEFT JOIN invoices AS iv
    ON it.InvoiceId = iv.InvoiceId
LEFT JOIN customers AS cu
    ON iv.CustomerId = cu.CustomerId
LEFT JOIN employees AS em
    ON cu.SupportRepId = em.EmployeeId
WHERE em.Title = 'Sales Support Agent'
GROUP BY em.LastName
;
*/
/*
--Query 14.: Which sales agent made the most sales in 2009?
SELECT SUM (it.UnitPrice*it.Quantity) AS Sales, em.FirstName, em.LastName, em.Title
FROM invoice_items AS it
LEFT JOIN invoices AS iv
    ON it.InvoiceId = iv.InvoiceId
LEFT JOIN customers AS cu
    ON iv.CustomerId = cu.CustomerId
LEFT JOIN employees AS em
    ON cu.SupportRepId = em.EmployeeId
WHERE em.Title = 'Sales Support Agent' AND iv.InvoiceDate LIKE '2009%'
GROUP BY em.LastName
ORDER BY SALES DESC
LIMIT 1
;
